# Copy to .env and fill in real values. Never commit .env.

# Any OpenAI-compatible API
OPENAI_API_KEY=
# Optional: leave empty for api.openai.com
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o

# Required to enable /api/v1/admin/* endpoints (sent as the X-Admin-Token header)
ADMIN_API_KEY=

# Optional tuning
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# CHROMA_DB_PATH=./chroma_db_store
# SIMILARITY_THRESHOLD=0.75
# TOP_K=3
# LLM_MAX_TOKENS=512
# CACHE_MAX_SIZE=1000

# Optional Langfuse keys
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
